{
  "name": "sistema-gestao-ruy-desktop-lab",
  "version": "0.10.0-rc.12",
  "private": true,
  "type": "module",
  "main": "windows-operational-entry.cjs",
  "description": "Sistema de Gestão Ruy — protótipo Windows isolado",
  "author": "Sistema Ruy",
  "dependencies": {
    "pg": "8.23.0"
  },
  "ruyRevision": "RUY-WINDOWS-OPERATIONAL-20261024",
  "ruyAppId": "br.ruy.gestao.windows.operacional",
  "ruyIndividualIdentity": true,
  "ruyRecoveredPreview": true,
  "ruyRelease": "RUY-RC12-EXCLUSAO-GASTOS-HOMOLOGACAO",
  "ruyOperationalWorkspace": true,
  "ruySharedLab": true,
  "ruySharedClientDefault": true,
  "ruyAuthentication": "user-session",
  "centralEndpoint": "https://quill-brunt-splinter.ngrok-free.dev",
  "discoveryPublicKey": "MCowBQYDK2VwAyEAil6lLl/9QGYKXWtR+YIAXauamsYZFqm6UKUfuN5wfqI=",
  "deploymentId": "ca47adbb-67a8-4459-b890-78cad643a615",
  "build": {
    "appId": "br.ruy.gestao.windows.operacional",
    "productName": "Sistema Ruy",
    "directories": {
      "output": "../artifacts/ruy-rc12-fix-20261031b",
      "app": "desktop"
    },
    "files": [
      "*.mjs",
      "*.cjs",
      "*.html",
      "setup-renderer.js",
      "assets/*",
      {
        "from": "../server/d1-lab",
        "to": "server/d1-lab",
        "filter": ["*.mjs", "*.sql"]
      },
      {
        "from": "../server/sync-lab",
        "to": "server/sync-lab",
        "filter": ["**/*.mjs", "**/*.cjs"]
      },
      {
        "from": "../server/central",
        "to": "server/central",
        "filter": ["public-discovery.mjs"]
      },
      "dist-d1/**/*",
      "central-endpoint.json",
      "central-endpoint.mjs",
      "nsis-shared-shortcuts.nsh",
      "!**/*-smoke.mjs",
      "!**/*-test.mjs",
      "!desktop/electron-builder-*.cjs"
    ],
    "win": {
      "target": "nsis",
      "icon": "desktop/assets/ruy.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Sistema-Ruy-Compartilhado-0.10.0-rc.12-Setup.${ext}",
      "runAfterFinish": false,
      "shortcutName": "Sistema Ruy",
      "include": "desktop/nsis-shared-shortcuts.nsh",
      "guid": "75c7b9b8-6d06-4bf1-89d1-4e566b45c050"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false
    }
  }
}